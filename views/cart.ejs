<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: "My Cart | BlueShop" }) %>
</head>

<body class="bg-gray-50">

  <!-- Navbar -->
  <%- include("partials/navbar", { user: user }) %>

  <!-- Page Header -->
  <section class="bg-gradient-to-br from-blue-600 to-blue-400 text-white">
    <div class="max-w-7xl mx-auto px-6 py-16 text-center">
      <h1 class="text-4xl font-bold mb-2">Shopping Cart</h1>
      <p class="text-blue-100">
        Review your items before checkout
      </p>
    </div>
  </section>

  <!-- Cart Content -->
  <section class="max-w-7xl mx-auto px-6 py-16 grid grid-cols-1 lg:grid-cols-3 gap-8">

    <!-- Cart Items -->
    <div class="lg:col-span-2 space-y-6">

      <!-- Cart Item -->
      <div class="bg-white rounded-xl shadow p-6 flex flex-col sm:flex-row gap-6">
        <div class="w-full sm:w-32 h-32 bg-blue-100 flex items-center justify-center rounded-lg">
          <span class="text-blue-500 font-semibold">Image</span>
        </div>

        <div class="flex-1">
          <h3 class="font-semibold text-lg">Product One</h3>
          <p class="text-gray-500 text-sm mb-2">High quality product</p>
          <span class="font-bold text-blue-600">₹999</span>
        </div>

        <div class="flex items-center gap-4">
          <input
            type="number"
            value="1"
            min="1"
            class="w-16 border rounded-lg px-2 py-1 text-center focus:ring-2 focus:ring-blue-500"
          />
          <button class="text-red-500 hover:text-red-600 font-semibold">
            Remove
          </button>
        </div>
      </div>

      <!-- Cart Item -->
      <div class="bg-white rounded-xl shadow p-6 flex flex-col sm:flex-row gap-6">
        <div class="w-full sm:w-32 h-32 bg-blue-100 flex items-center justify-center rounded-lg">
          <span class="text-blue-500 font-semibold">Image</span>
        </div>

        <div class="flex-1">
          <h3 class="font-semibold text-lg">Product Two</h3>
          <p class="text-gray-500 text-sm mb-2">Best seller</p>
          <span class="font-bold text-blue-600">₹1499</span>
        </div>

        <div class="flex items-center gap-4">
          <input
            type="number"
            value="2"
            min="1"
            class="w-16 border rounded-lg px-2 py-1 text-center focus:ring-2 focus:ring-blue-500"
          />
          <button class="text-red-500 hover:text-red-600 font-semibold">
            Remove
          </button>
        </div>
      </div>

    </div>

    <!-- Order Summary -->
    <div class="bg-white rounded-xl shadow p-6 h-fit">
      <h2 class="text-xl font-bold mb-6">Order Summary</h2>

      <div class="space-y-3 text-sm text-gray-600">
        <div class="flex justify-between">
          <span>Subtotal</span>
          <span>₹2498</span>
        </div>
        <div class="flex justify-between">
          <span>Shipping</span>
          <span>₹99</span>
        </div>
        <div class="flex justify-between font-semibold text-gray-800">
          <span>Total</span>
          <span>₹2597</span>
        </div>
      </div>

      <button
        class="w-full mt-6 bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-lg font-semibold">
        Proceed to Checkout
      </button>
    </div>

  </section>

  <!-- Footer -->
  <%- include("partials/footer") %>

</body>
</html>
