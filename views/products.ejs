<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: "Products | BlueShop" }) %>
</head>

<body class="bg-gray-50">

  <!-- Navbar -->
  <%- include("partials/navbar", { user: user }) %>

  <!-- Page Header -->
  <section class="bg-gradient-to-br from-blue-600 to-blue-400 text-white">
    <div class="max-w-7xl mx-auto px-6 py-16 text-center">
      <h1 class="text-4xl font-bold mb-2">Our Products</h1>
      <p class="text-blue-100">
        Browse our latest and best-selling products
      </p>
    </div>
  </section>

  <!-- Products Grid -->
  <section class="max-w-7xl mx-auto px-6 py-16">

    <!-- Filters (UI only for now) -->
    <div class="flex flex-col md:flex-row justify-between items-center mb-10 gap-4">
      <h2 class="text-2xl font-bold text-blue-700">
        All Products
      </h2>

      <select
        class="px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
        <option>Sort by</option>
        <option>Price: Low to High</option>
        <option>Price: High to Low</option>
        <option>Newest</option>
      </select>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">

      <!-- Product Card -->
      <div class="bg-white rounded-xl shadow hover:shadow-lg transition">
        <div class="h-48 bg-blue-100 flex items-center justify-center rounded-t-xl">
          <span class="text-blue-500 font-semibold">Image</span>
        </div>

        <div class="p-5">
          <h3 class="font-semibold text-lg mb-1">Product One</h3>
          <p class="text-gray-500 text-sm mb-3">
            High quality product
          </p>

          <div class="flex justify-between items-center">
            <span class="font-bold text-blue-600">₹999</span>
            <button
              class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm">
              Add to Cart
            </button>
          </div>
        </div>
      </div>

      <!-- Product Card -->
      <div class="bg-white rounded-xl shadow hover:shadow-lg transition">
        <div class="h-48 bg-blue-100 flex items-center justify-center rounded-t-xl">
          <span class="text-blue-500 font-semibold">Image</span>
        </div>

        <div class="p-5">
          <h3 class="font-semibold text-lg mb-1">Product Two</h3>
          <p class="text-gray-500 text-sm mb-3">
            Best seller
          </p>

          <div class="flex justify-between items-center">
            <span class="font-bold text-blue-600">₹1499</span>
            <button
              class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm">
              Add to Cart
            </button>
          </div>
        </div>
      </div>

      <!-- Product Card -->
      <div class="bg-white rounded-xl shadow hover:shadow-lg transition">
        <div class="h-48 bg-blue-100 flex items-center justify-center rounded-t-xl">
          <span class="text-blue-500 font-semibold">Image</span>
        </div>

        <div class="p-5">
          <h3 class="font-semibold text-lg mb-1">Product Three</h3>
          <p class="text-gray-500 text-sm mb-3">
            Limited offer
          </p>

          <div class="flex justify-between items-center">
            <span class="font-bold text-blue-600">₹799</span>
            <button
              class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm">
              Add to Cart
            </button>
          </div>
        </div>
      </div>

      <!-- Product Card -->
      <div class="bg-white rounded-xl shadow hover:shadow-lg transition">
        <div class="h-48 bg-blue-100 flex items-center justify-center rounded-t-xl">
          <span class="text-blue-500 font-semibold">Image</span>
        </div>

        <div class="p-5">
          <h3 class="font-semibold text-lg mb-1">Product Four</h3>
          <p class="text-gray-500 text-sm mb-3">
            New arrival
          </p>

          <div class="flex justify-between items-center">
            <span class="font-bold text-blue-600">₹1299</span>
            <button
              class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm">
              Add to Cart
            </button>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Footer -->
  <%- include("partials/footer") %>

</body>
</html>
