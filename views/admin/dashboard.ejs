<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head", { title: "Admin Dashboard | BlueShop" }) %>
</head>

<body class="bg-gray-100">

  <!-- Navbar -->
  <%- include("../partials/navbar", { user: user }) %>

  <!-- Page Header -->
  <section class="bg-gradient-to-br from-blue-600 to-blue-400 text-white">
    <div class="max-w-7xl mx-auto px-6 py-12">
      <h1 class="text-3xl font-bold">Admin Dashboard</h1>
      <p class="text-blue-100">Welcome, <%= user ? user.fullname : "Admin" %></p>
    </div>
  </section>

  <!-- Dashboard Content -->
  <section class="max-w-7xl mx-auto px-6 py-12 grid grid-cols-1 md:grid-cols-4 gap-6">

    <!-- Card -->
    <div class="bg-white rounded-xl shadow p-6 text-center">
      <h3 class="text-gray-500 text-sm">Total Products</h3>
      <p class="text-3xl font-bold text-blue-600 mt-2">
        <%= user?.products?.length || 0 %>
      </p>
    </div>

    <div class="bg-white rounded-xl shadow p-6 text-center">
      <h3 class="text-gray-500 text-sm">Admin Email</h3>
      <p class="text-sm font-semibold mt-2">
        <%= user?.email || "admin@shop.com" %>
      </p>
    </div>

    <div class="bg-white rounded-xl shadow p-6 text-center">
      <h3 class="text-gray-500 text-sm">GSTIN</h3>
      <p class="text-sm font-semibold mt-2">
        <%= user?.gstin || "Not Added" %>
      </p>
    </div>

    <div class="bg-white rounded-xl shadow p-6 text-center">
      <h3 class="text-gray-500 text-sm">Account Status</h3>
      <span class="inline-block mt-2 px-4 py-1 bg-green-100 text-green-700 rounded-full text-sm">
        Active
      </span>
    </div>

  </section>

  <!-- Quick Actions -->
  <section class="max-w-7xl mx-auto px-6 pb-16 grid grid-cols-1 md:grid-cols-3 gap-6">

    <a href="/admin/profile"
      class="bg-white rounded-xl shadow p-6 hover:shadow-lg transition">
      <h3 class="font-semibold text-lg text-blue-600">Admin Profile</h3>
      <p class="text-sm text-gray-500 mt-1">
        View & update admin details
      </p>
    </a>

    <a href="/admin/products"
      class="bg-white rounded-xl shadow p-6 hover:shadow-lg transition">
      <h3 class="font-semibold text-lg text-blue-600">Manage Products</h3>
      <p class="text-sm text-gray-500 mt-1">
        Add, edit or delete products
      </p>
    </a>

    <a href="/admin/orders"
      class="bg-white rounded-xl shadow p-6 hover:shadow-lg transition">
      <h3 class="font-semibold text-lg text-blue-600">View Orders</h3>
      <p class="text-sm text-gray-500 mt-1">
        Manage customer orders
      </p>
    </a>

  </section>

  <!-- Footer -->
  <%- include("../partials/footer") %>

</body>
</html>
