<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: "Home | BlueShop" }) %>
</head>

<body class="bg-gray-50">

  <!-- Navbar -->
  <%- include("partials/navbar", { user: user }) %>

  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-blue-600 to-blue-400 text-white">
    <div class="max-w-7xl mx-auto px-6 py-20 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">
        Smart Shopping Starts Here
      </h1>
      <p class="text-lg text-blue-100 mb-8">
        Discover quality products at unbeatable prices
      </p>
      <a
        href="/products"
        class="bg-white text-blue-600 px-8 py-3 rounded-lg font-semibold hover:bg-gray-100 transition"
      >
        Shop Now
      </a>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="max-w-7xl mx-auto px-6 py-16">
    <h2 class="text-3xl font-bold text-center text-blue-700 mb-12">
      Featured Products
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">

      <!-- Product Card -->
      <div class="bg-white rounded-xl shadow hover:shadow-lg transition">
        <div class="h-48 bg-blue-100 flex items-center justify-center rounded-t-xl">
          <span class="text-blue-500 font-semibold">Image</span>
        </div>
        <div class="p-5">
          <h3 class="font-semibold text-lg">Product One</h3>
          <p class="text-gray-500 text-sm mb-3">High quality product</p>
          <div class="flex justify-between items-center">
            <span class="font-bold text-blue-600">₹999</span>
            <button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg">
              Add to Cart
            </button>
          </div>
        </div>
      </div>

      <!-- Product Card -->
      <div class="bg-white rounded-xl shadow hover:shadow-lg transition">
        <div class="h-48 bg-blue-100 flex items-center justify-center rounded-t-xl">
          <span class="text-blue-500 font-semibold">Image</span>
        </div>
        <div class="p-5">
          <h3 class="font-semibold text-lg">Product Two</h3>
          <p class="text-gray-500 text-sm mb-3">Best seller</p>
          <div class="flex justify-between items-center">
            <span class="font-bold text-blue-600">₹1499</span>
            <button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg">
              Add to Cart
            </button>
          </div>
        </div>
      </div>

      <!-- Product Card -->
      <div class="bg-white rounded-xl shadow hover:shadow-lg transition">
        <div class="h-48 bg-blue-100 flex items-center justify-center rounded-t-xl">
          <span class="text-blue-500 font-semibold">Image</span>
        </div>
        <div class="p-5">
          <h3 class="font-semibold text-lg">Product Three</h3>
          <p class="text-gray-500 text-sm mb-3">Limited offer</p>
          <div class="flex justify-between items-center">
            <span class="font-bold text-blue-600">₹799</span>
            <button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg">
              Add to Cart
            </button>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Call To Action -->
  <section class="bg-blue-600 text-white text-center py-16">
    <h2 class="text-3xl font-bold mb-4">
      Ready to Start Shopping?
    </h2>
    <p class="text-blue-100 mb-6">
      Create an account and enjoy exclusive deals
    </p>
    <a
      href="/signup"
      class="bg-white text-blue-600 px-8 py-3 rounded-lg font-semibold hover:bg-gray-100"
    >
      Get Started
    </a>
  </section>

  <!-- Footer -->
  <%- include("partials/footer") %>

</body>
</html>
